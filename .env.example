# Copia este archivo como .env y cambia las contraseñas.

# Usuario y grupo de tu máquina dueños de las carpetas (comando: id)
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Contraseña de la API/Web UI de aMule (la usa el buscador para hablar con aMule)
AMULE_WEBUI_PWD=cambia-esto-1
# Contraseña de External Connections (amulecmd / amulegui)
AMULE_EC_PWD=cambia-esto-2

# Acceso a tu buscador (usuario/contraseña del navegador). Déjala vacía para no pedir login.
APP_USER=luis
APP_PASSWORD=cambia-esto-3

# Carpetas en tu máquina
AMULE_CONFIG_DIR=./data/config
AMULE_DOWNLOADS_DIR=./data/downloads

# Puerto donde se abre el buscador
BUSCADOR_PORT=8080
